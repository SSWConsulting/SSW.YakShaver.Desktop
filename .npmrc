# Tag prefix for monorepo - distinguishes this app's releases.
# npm-only key. CI always passes --no-git-tag-version, so releases do not rely on it.
tag-version-prefix=desktop-electron-v

# Make npm honour the engines field, so `npm install` fails instead of warning. pnpm has its
# own engineStrict in pnpm-workspace.yaml and does not read this key; without both, the
# "npm": "please-use-pnpm" entry in package.json is only ever a warning npm prints and ignores.
engine-strict=true

# pnpm 11 and newer read their own settings from pnpm-workspace.yaml, not from here. The
# nodeLinker, engineStrict and allowBuilds keys all live in that file.
